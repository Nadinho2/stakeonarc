# VIBE: Copy to `.env` in this `contracts/` folder (or export in shell) — never commit real keys



PRIVATE_KEY=your_private_key_here



# VIBE: VibeToken address — used by `script/DeployVibePredictionMarket.s.sol` and other deploy scripts

VIBE_TOKEN=0x0000000000000000000000000000000000000000



# VIBE: Deployed VibeStaking (Arc Testnet) — used by `script/SetRewardRate.s.sol` and `DeployVibePredictionMarket.s.sol`

VIBE_STAKING_ADDRESS=0xebae6fa1EeF51Ee54d1289dD7253DDC257Cd897b



# VIBE: New global emission: reward tokens per second for the *entire* pool (18 decimals).

# Example: 0.01 VIBE/s => 10000000000000000 (0.01 * 1e18)

REWARD_RATE=10000000000000000



# VIBE: Optional — only if you override `foundry.toml` rpc_endpoints with an env placeholder

# ARC_TESTNET_RPC=https://rpc.testnet.arc.network

