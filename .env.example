# VIBE: Arc Testnet RPC endpoint URL
ARC_TESTNET_RPC=https://your-arc-testnet-rpc

# VIBE: EOA private key for deployments (DO NOT COMMIT REAL KEY)
PRIVATE_KEY=0xyourprivatekey

# VIBE: WalletConnect Project ID from cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id

# VIBE: optional frontend RPC override (if you do not want default in code)
NEXT_PUBLIC_ARC_TESTNET_RPC=https://your-arc-testnet-rpc

# VIBE: deploy script extras for contract constructor
ARC_STAKE_TOKEN=0xYourStakeTokenAddress
ARC_OWNER=0xYourOwnerWallet
